<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/biru">

    <!-- Header Gelombang Tipis (110dp) -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Teks Home Pas di Atas Header -->
    <TextView
        android:id="@+id/tvTitleHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="Home"
        android:textColor="#399DA6"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Grid Menu Pertemuan -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridMenuHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="270dp"
        app:columnCount="2"
        app:useDefaultMargins="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Pertemuan 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFourth"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:backgroundTint="#2196CC"
            android:text="Pertemuan 4"
            android:textSize="13sp"
            app:cornerRadius="25dp" />

        <!-- Pertemuan 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFifth"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:backgroundTint="#00AAC5"
            android:text="Pertemuan 5"
            android:textSize="13sp"
            app:cornerRadius="25dp" />

        <!-- Pertemuan 6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToSixth"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:backgroundTint="#3F51B5"
            android:text="Pertemuan 6"
            android:textSize="13sp"
            app:cornerRadius="25dp" />

        <!-- Pertemuan 10 (Tetap Ada) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToTenth"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:backgroundTint="#1B2A4A"
            android:text="Pertemuan 10"
            android:textSize="13sp"
            app:cornerRadius="25dp" />

        <!-- Pertemuan 11 (Ditambahkan Baru) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToEleventh"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:backgroundTint="#223ED7"
            android:text="Pertemuan 11"
            android:textSize="13sp"
            app:cornerRadius="25dp" />

    </androidx.gridlayout.widget.GridLayout>

    <!-- Tombol Logout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#093D66"
        android:text="Logout"
        android:textSize="14sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridMenuHome" />

</androidx.constraintlayout.widget.ConstraintLayout>